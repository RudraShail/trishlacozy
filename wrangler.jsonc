{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trishlacozy",
  "compatibility_date": "2026-10-26",
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
